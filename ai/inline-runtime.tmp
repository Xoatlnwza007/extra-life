<script data-inline-module="decision-engine">
/* One Piece Life Simulator — autonomous decision engine
 * Pure utility scorer. No DOM, storage, or game-global dependencies.
 * Integration contract: decide(state, candidates, context) -> { action, ranking }.
 */
(function (root) {
  'use strict';

  const clamp = (n, lo, hi) => Math.max(lo, Math.min(hi, n));
  const num = (v, fallback = 0) => Number.isFinite(Number(v)) ? Number(v) : fallback;
  const tokens = value => Array.isArray(value) ? value : String(value || '').split(/[\s,|]+/).filter(Boolean);

  function needValue(state, action) {
    const needs = state.needs || {};
    const relief = action.relief || {};
    let score = 0;
    for (const [key, amount] of Object.entries(relief)) {
      const deficit = clamp(100 - num(needs[key], 50), 0, 100) / 100;
      score += deficit * num(amount) * 0.24;
    }
    return score;
  }

  function goalValue(state, action) {
    const goals = state.goals || [];
    const tags = new Set(tokens(action.tags));
    let score = 0;
    for (const goal of goals) {
      if (goal.status && goal.status !== 'active') continue;
      const weight = clamp(num(goal.priority, 50) / 50, 0.2, 2);
      if (goal.action === action.id || (goal.tags || []).some(tag => tags.has(tag))) {
        score += 18 * weight;
      }
    }
    return score;
  }

  function personalityValue(state, action) {
    const traits = state.traits || [];
    const tags = tokens(action.tags);
    let score = 0;
    for (const trait of traits) {
      const preferences = (state.personalityPreferences || {})[trait] || {};
      for (const tag of tags) score += num(preferences[tag]) * 3;
      if (action.risk > 0 && trait === 'cautious') score -= action.risk * 0.12;
      if (action.risk > 0 && ['brave', 'reckless', 'ambitious'].includes(trait)) score += action.risk * 0.07;
    }
    return score;
  }

  function memoryValue(state, action) {
    const memories = state.memories || [];
    const tags = new Set(tokens(action.tags));
    let score = 0;
    for (const memory of memories.slice(-40)) {
      if (memory.expired) continue;
      const relevance = (memory.tags || []).filter(tag => tags.has(tag)).length;
      if (!relevance) continue;
      const strength = clamp(num(memory.importance, 1), 0, 5);
      const polarity = memory.polarity === 'negative' ? -1 : 1;
      score += relevance * strength * polarity * 1.5;
    }
    return clamp(score, -15, 15);
  }

  function scoreAction(state, action, context = {}) {
    if (action.available === false) return { id: action.id, score: -Infinity, reasons: ['unavailable'] };
    const risk = clamp(num(action.risk), 0, 100);
    const riskTolerance = clamp(num(state.riskTolerance, 35), 0, 100);
    const riskPenalty = Math.max(0, risk - riskTolerance) * 0.28;
    const resourceCost = num(action.resourceCost) * (1 + num(context.resourcePressure) / 100);
    const travelCost = num(action.travelCost) * (1 + num(context.travelDanger) / 100);
    const reward = num(action.expectedReward);
    const opportunity = num(action.opportunityValue);
    const relationship = num(action.relationshipValue);
    const need = needValue(state, action);
    const goal = goalValue(state, action);
    const personality = personalityValue(state, action);
    const memory = memoryValue(state, action);
    const score = need + goal + personality + memory + opportunity + relationship + reward
      - riskPenalty - resourceCost - travelCost;
    return {
      id: action.id,
      score: Number(score.toFixed(3)),
      reasons: [
        ['needs', need], ['goals', goal], ['personality', personality],
        ['memory', memory], ['opportunity', opportunity], ['relationships', relationship],
        ['reward', reward], ['risk penalty', -riskPenalty],
        ['resource cost', -resourceCost], ['travel cost', -travelCost]
      ].filter(([, value]) => Math.abs(value) > 0.001)
    };
  }

  function decide(state, candidates, context = {}) {
    const ranking = (candidates || [])
      .map(action => ({ action, evaluation: scoreAction(state || {}, action, context) }))
      .filter(item => Number.isFinite(item.evaluation.score))
      .sort((a, b) => b.evaluation.score - a.evaluation.score);
    return {
      action: ranking.length ? ranking[0].action : null,
      ranking: ranking.map(item => ({ id: item.evaluation.id, score: item.evaluation.score, reasons: item.evaluation.reasons }))
    };
  }

  const api = Object.freeze({ decide, scoreAction });
  if (typeof module !== 'undefined' && module.exports) module.exports = api;
  root.OnePieceDecisionEngine = api;
})(typeof globalThis !== 'undefined' ? globalThis : this);

</script>
<script data-inline-module="character-state">
/* One Piece Life Simulator — persistent NPC memory and goals.
 * Pure state helpers. Storage is owned by the game layer.
 */
(function (root) {
  'use strict';

  const clamp = (value, min, max) => Math.max(min, Math.min(max, value));
  const makeId = (prefix) => prefix + '-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 8);

  function createCharacterState(input = {}) {
    return {
      id: input.id || makeId('character'),
      traits: Array.isArray(input.traits) ? [...input.traits] : [],
      personalityPreferences: { ...(input.personalityPreferences || {}) },
      riskTolerance: clamp(Number(input.riskTolerance ?? 35), 0, 100),
      needs: { ...(input.needs || {}) },
      memories: Array.isArray(input.memories) ? input.memories.slice(-100) : [],
      goals: Array.isArray(input.goals) ? input.goals : [],
      relationships: { ...(input.relationships || {}) },
      inventory: Array.isArray(input.inventory) ? input.inventory : [],
      lastDecision: input.lastDecision || null,
      updatedAt: input.updatedAt || new Date().toISOString()
    };
  }

  function remember(character, event, options = {}) {
    if (!character || !event) return character;
    const memory = {
      id: options.id || makeId('memory'),
      event: String(event),
      tags: Array.isArray(options.tags) ? [...new Set(options.tags.map(String))] : [],
      importance: clamp(Number(options.importance ?? 1), 0, 5),
      polarity: options.polarity === 'negative' ? 'negative' : 'positive',
      createdAt: options.createdAt || new Date().toISOString(),
      expiresAt: options.expiresAt || null,
      expired: false,
      source: options.source || 'world'
    };
    const memories = [...(character.memories || []), memory];
    return { ...character, memories: memories.slice(-100), updatedAt: new Date().toISOString() };
  }

  function addGoal(character, goal) {
    if (!character || !goal || !goal.description) return character;
    const nextGoal = {
      id: goal.id || makeId('goal'),
      description: String(goal.description),
      action: goal.action || null,
      tags: Array.isArray(goal.tags) ? [...new Set(goal.tags.map(String))] : [],
      priority: clamp(Number(goal.priority ?? 50), 0, 100),
      status: 'active',
      createdAt: goal.createdAt || new Date().toISOString(),
      deadline: goal.deadline || null
    };
    return { ...character, goals: [...(character.goals || []), nextGoal], updatedAt: new Date().toISOString() };
  }

  function updateGoal(character, goalId, status) {
    const allowed = ['active', 'completed', 'abandoned'];
    if (!character || !allowed.includes(status)) return character;
    return {
      ...character,
      goals: (character.goals || []).map(goal => goal.id === goalId
        ? { ...goal, status, updatedAt: new Date().toISOString() }
        : goal),
      updatedAt: new Date().toISOString()
    };
  }

  function getRelationship(character, targetId) {
    if (!character || !targetId) return 0;
    const value = (character.relationships || {})[targetId];
    return clamp(Number(value) || 0, -100, 100);
  }

  function adjustRelationship(character, targetId, delta, options = {}) {
    if (!character || !targetId) return character;
    const amount = Number(delta);
    if (!Number.isFinite(amount) || amount === 0) return character;
    const current = getRelationship(character, targetId);
    const score = clamp(current + amount, -100, 100);
    const history = [...(character.relationshipHistory || []), {
      targetId: String(targetId),
      delta: score - current,
      score,
      event: options.event ? String(options.event) : null,
      createdAt: options.createdAt || new Date().toISOString()
    }].slice(-50);
    return {
      ...character,
      relationships: { ...(character.relationships || {}), [targetId]: score },
      relationshipHistory: history,
      updatedAt: new Date().toISOString()
    };
  }

  function interact(first, second, delta, options = {}) {
    if (!first || !second || !first.id || !second.id || first.id === second.id) {
      return { first, second };
    }
    const firstDelta = Number(delta);
    const secondDelta = Number(options.replyDelta ?? delta);
    const nextFirst = Number.isFinite(firstDelta)
      ? adjustRelationship(first, second.id, firstDelta, {
          event: options.event || 'interaction',
          createdAt: options.createdAt
        })
      : first;
    const nextSecond = Number.isFinite(secondDelta)
      ? adjustRelationship(second, first.id, secondDelta, {
          event: options.replyEvent || options.event || 'interaction',
          createdAt: options.createdAt
        })
      : second;
    return { first: nextFirst, second: nextSecond };
  }

  function relationshipLabel(score) {
    const value = clamp(Number(score) || 0, -100, 100);
    if (value >= 80) return 'devoted';
    if (value >= 50) return 'trusted';
    if (value >= 20) return 'friendly';
    if (value <= -80) return 'nemesis';
    if (value <= -50) return 'hostile';
    if (value <= -20) return 'unfriendly';
    return 'neutral';
  }

  function advanceTime(character, now = Date.now()) {
    if (!character) return character;
    const memories = (character.memories || []).map(memory => {
      if (!memory.expiresAt || memory.expired) return memory;
      return { ...memory, expired: new Date(memory.expiresAt).getTime() <= now };
    });
    const goals = (character.goals || []).map(goal => {
      if (goal.status !== 'active' || !goal.deadline) return goal;
      return new Date(goal.deadline).getTime() <= now
        ? { ...goal, status: 'abandoned', expiredAt: new Date(now).toISOString() }
        : goal;
    });
    return { ...character, memories, goals, updatedAt: new Date(now).toISOString() };
  }

  const api = Object.freeze({ createCharacterState, remember, addGoal, updateGoal, getRelationship, adjustRelationship, interact, relationshipLabel, advanceTime });
  if (typeof module !== 'undefined' && module.exports) module.exports = api;
  root.OnePieceCharacterState = api;
})(typeof globalThis !== 'undefined' ? globalThis : this);

</script>
<script data-inline-module="npc-brain">
/* One Piece Life Simulator — NPC decision adapter.
 * Bridges character state + candidate activities to decision-engine.js.
 */
(function (root) {
  'use strict';

  function getDependencies() {
    const engine = root.OnePieceDecisionEngine;
    const stateApi = root.OnePieceCharacterState;
    if (!engine || !stateApi) throw new Error('Load decision-engine.js and character-state.js before npc-brain.js');
    return { engine, stateApi };
  }

  function decide(character, candidates, context = {}) {
    const { engine } = getDependencies();
    const result = engine.decide(character || {}, candidates || [], context);
    return {
      action: result.action,
      ranking: result.ranking,
      characterId: character && character.id || null,
      decidedAt: new Date().toISOString()
    };
  }

  function recordOutcome(character, decision, outcome = {}) {
    const { stateApi } = getDependencies();
    if (!character || !decision || !decision.action) return character;
    const action = decision.action;
    const next = {
      ...character,
      lastDecision: {
        actionId: action.id,
        decidedAt: decision.decidedAt || new Date().toISOString(),
        score: (decision.ranking || []).find(item => item.id === action.id)?.score ?? null
      }
    };
    const event = outcome.event || ('ทำกิจกรรม: ' + (action.label || action.name || action.id));
    return stateApi.remember(next, event, {
      tags: [...new Set([...(Array.isArray(action.tags) ? action.tags : []), ...(Array.isArray(outcome.tags) ? outcome.tags : outcome.tags ? [outcome.tags] : [])].map(String))],
      importance: outcome.importance ?? 1,
      polarity: outcome.polarity || 'positive',
      source: 'npc-action'
    });
  }

  const api = Object.freeze({ decide, recordOutcome });
  if (typeof module !== 'undefined' && module.exports) module.exports = api;
  root.OnePieceNPCBrain = api;
})(typeof globalThis !== 'undefined' ? globalThis : this);

</script>
<script data-inline-module="event-adapter">
/* One Piece Life Simulator — event decision adapter
 * Bridges legacy game choices to OnePieceDecisionEngine without executing
 * choice effects. The original choice object is returned for the game to apply.
 */
(function (root) {
  'use strict';

  function number(value, fallback = 0) {
    const parsed = Number(value);
    return Number.isFinite(parsed) ? parsed : fallback;
  }

  function isAvailable(choice) {
    const source = choice || {};
    return source.available !== false && source.disabled !== true &&
      source.ok !== false && source.skip !== true;
  }

  function toCandidate(choice, index) {
    const source = choice || {};
    const effects = source.effects || source.effect || {};
    const tags = source.tags || source.aiTags || source.category || source.g || [];
    const relief = source.relief || source.needRelief || {};
    return {
      id: String(source.id ?? source.key ?? 'choice-' + index),
      available: isAvailable(source),
      tags,
      relief,
      risk: number(source.risk ?? source.danger),
      resourceCost: number(source.resourceCost ?? source.cost),
      travelCost: number(source.travelCost),
      expectedReward: number(source.expectedReward ?? source.reward ?? effects.reward),
      opportunityValue: number(source.opportunityValue),
      relationshipValue: number(source.relationshipValue ?? effects.relationship),
      original: source
    };
  }

  function choose(state, choices, context = {}) {
    const options = Array.isArray(choices) ? choices : [];
    const available = options.filter(isAvailable);
    if (!available.length) return { choice: null, ranking: [], usedAI: false };

    const engine = root.OnePieceDecisionEngine;
    if (!engine || typeof engine.decide !== 'function') {
      return { choice: available[0], ranking: [], usedAI: false };
    }

    const candidates = available.map(toCandidate);
    const result = engine.decide(state || {}, candidates, context);
    if (!result || !result.action) {
      return { choice: available[0], ranking: [], usedAI: false };
    }

    return {
      choice: result.action.original || available[0],
      ranking: result.ranking || [],
      usedAI: true
    };
  }

  const api = Object.freeze({ choose, toCandidate, isAvailable });
  if (typeof module !== 'undefined' && module.exports) module.exports = api;
  root.OnePieceEventAdapter = api;
})(typeof globalThis !== 'undefined' ? globalThis : this);

</script>
<script data-inline-module="east-blue-starter">
/* One Piece Life Simulator — original East Blue starter side-story.
 * These events are explicitly sandbox/original content, not manga canon.
 * The factory receives the legacy game's effect helpers and preserves its
 * existing event/choice contract.
 */
(function (root) {
  'use strict';

  function create(api = {}) {
    const call = (name, ...args) => {
      if (typeof api[name] === 'function') return api[name](...args);
      return undefined;
    };
    const flag = (state, key, value = 1) => {
      state.flags = state.flags || {};
      state.flags[key] = value;
    };

    return [
      {
        id: 'op_eb_toma_net',
        t: '[เนื้อเรื่องเสริม] อวนที่หายไป',
        once: 1,
        w: 10,
        origin: 'original',
        canonStatus: 'sandbox',
        homeOnly: true,
        when: S => S.place === 'foosha' && S.age >= 8 && S.age <= 18 && !S.flags?.eb_toma_met,
        play() {
          return {
            text: 'ชาวประมงชื่อโทมะกำลังตามหาอวนกับลังเสบียงที่กระแสน้ำพัดหายไป เขาขอให้คุณช่วยก่อนที่แสงสุดท้ายจะหมดลง',
            choices: [
              {
                l: 'ช่วยเดินสำรวจแนวโขดหิน',
                g: 'kind help brave',
                f(S) {
                  flag(S, 'eb_toma_met');
                  flag(S, 'eb_net_found');
                  call('bond', 'eb_toma', 12);
                  call('skill', 'ride', 2);
                  call('st', 'joy', 3);
                  call('say', 'คุณพบอวนติดอยู่กับโขดหินและช่วยลากกลับมา โทมะจำความช่วยเหลือของคุณไว้', 'good');
                }
              },
              {
                l: 'ช่วยตามหา แต่ขอค่าตอบแทนเล็กน้อย',
                g: 'ambitious trade',
                f(S) {
                  flag(S, 'eb_toma_met');
                  flag(S, 'eb_net_found');
                  call('bond', 'eb_toma', 5);
                  call('mon', 4);
                  call('say', 'คุณช่วยโทมะกู้เสบียงกลับมาได้ เขาจ่ายค่าตอบแทนตามที่ตกลง', 'good');
                }
              },
              {
                l: 'ถามชาวบ้านให้ช่วยกันค้นหา',
                g: 'curious kind',
                f(S) {
                  flag(S, 'eb_toma_met');
                  flag(S, 'eb_net_found');
                  call('bond', 'eb_toma', 8);
                  call('skill', 'charm', 1);
                  call('say', 'ข่าวแพร่ไปทั่วหมู่บ้าน ไม่นานทุกคนก็ช่วยกันหาอวนจนพบ', 'good');
                }
              }
            ]
          };
        }
      },
      {
        id: 'op_eb_dock_repair',
        t: '[เนื้อเรื่องเสริม] ซ่อมท่าเรือก่อนน้ำขึ้น',
        once: 1,
        w: 10,
        origin: 'original',
        canonStatus: 'sandbox',
        homeOnly: true,
        when: S => S.place === 'foosha' && S.age >= 9 && !!S.flags?.eb_net_found && !S.flags?.eb_boat_repaired,
        play() {
          return {
            text: 'หลังจากได้อวนคืน โทมะชวนคุณไปดูเรือประมงลำเล็กที่เชือกผูกกับท่าเรือเริ่มขาด ไม้กระดานบางแผ่นก็หลวมจนเดินแทบไม่ได้',
            choices: [
              {
                l: 'ช่วยช่างไม้เปลี่ยนกระดาน',
                g: 'craft help diligent',
                f(S) {
                  flag(S, 'eb_boat_repaired');
                  call('bond', 'eb_toma', 8);
                  call('skill', 'craft', 3);
                  call('say', 'คุณช่วยยึดกระดานและตรวจเชือกผูกเรือจนแน่นหนา', 'good');
                }
              },
              {
                l: 'รวบรวมเพื่อนบ้านมาช่วยกัน',
                g: 'kind leader',
                f(S) {
                  flag(S, 'eb_boat_repaired');
                  call('bond', 'eb_toma', 10);
                  call('skill', 'charm', 2);
                  call('st', 'joy', 2);
