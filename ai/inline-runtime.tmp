                g: 'curious diligent',
                f(S) {
                  flag(S, 'eb_boat_repaired');
                  call('bond', 'eb_toma', 6);
                  call('skill', 'ride', 2);
                  call('say', 'โทมะสอนปมเชือกสำหรับเรือให้คุณจนจำได้ขึ้นใจ', 'good');
